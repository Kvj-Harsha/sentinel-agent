# Copy to .env (never commit .env). Only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-...

# Prometheus Alertmanager webhook (required to enable the receiver in Streamlit).
# Generate one random value, put it here and in .secrets/sentinel_webhook_token.
SENTINEL_WEBHOOK_TOKEN=<random-secret-at-least-24-characters>
SENTINEL_WEBHOOK_HOST=0.0.0.0
SENTINEL_WEBHOOK_PORT=8090

# --- Optional overrides ---------------------------------------------------------------
# Use another OpenAI-compatible provider (e.g. OpenRouter) and its model slugs:
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# SENTINEL_PRIMARY_MODEL=openai/gpt-4o-mini
# SENTINEL_FALLBACK_MODEL=anthropic/claude-haiku-4.5

# Repository the live GitHub deploy-history tool reads commits from (falls back to an
# offline cache if unreachable):
# GITHUB_REPO_OWNER=<your-github-username>
# GITHUB_REPO_NAME=sentinel-agent

# Dedicated mock checkout repository used for issue-first, human-reviewed repair PRs.
# Use a fine-grained token scoped only to that repository with Contents: read/write,
# Issues: read/write, Pull requests: read/write, and Checks: read. Keep the actual token in local .env only.
# SENTINEL_GITHUB_TOKEN=github_pat_...
# SENTINEL_DEMO_GITHUB_OWNER=<your-github-username>
# SENTINEL_DEMO_GITHUB_REPO=checkout-demo-app
# SENTINEL_DEMO_APP_URL=http://127.0.0.1:8000
# SENTINEL_DEMO_APP_CONFIG_PATH=C:\Users\you\Downloads\checkout-demo-app\app\settings.json

# Optional: mirror tickets to a REAL ServiceNow instance (free Personal Developer Instance works).
# Without these three, tickets stay in the local JSON store.
# SERVICENOW_INSTANCE=dev12345            # or the full https://dev12345.service-now.com
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=<your PDI admin password>
# SERVICENOW_CLOSE_CODE=Solution provided   # must match a Resolution code choice on your instance
# SERVICENOW_CALLER=admin                 # user_name shown as Caller (default: SERVICENOW_USER)
# SERVICENOW_ASSIGNEE=<user_name>        # default: an active member of the assignment group
# SERVICENOW_ASSIGNMENT_GROUP=Software    # assignment group name
