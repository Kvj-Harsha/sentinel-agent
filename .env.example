# Copy to .env (never commit .env). Only OPENAI_API_KEY is required.
# For OpenRouter set OPENAI_API_KEY to your OpenRouter key and OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-...

# demo (default): replay the bundled scenario, reproducible offline, evidence labelled `fixture`.
# live: query Prometheus, Loki, GitHub Deployments and Confluence (configure them below).
# SENTINEL_MODE=demo

# --- Durable local state ----------------------------------------------------------------
# SQLite is the local single-host store; PostgreSQL is deferred until shared multi-worker
# deployment is required. The first SQLite startup imports existing JSON ticket/history data.
SENTINEL_STORAGE_BACKEND=sqlite
SENTINEL_DB_PATH=coded_tools/sentinel/data/sentinel.db

# Prometheus Alertmanager webhook (required to enable the receiver in Streamlit).
# Generate one random value, put it here and in .secrets/sentinel_webhook_token.
SENTINEL_WEBHOOK_TOKEN=<random-secret-at-least-24-characters>
SENTINEL_WEBHOOK_HOST=0.0.0.0
SENTINEL_WEBHOOK_PORT=8090

# --- Read-only Prometheus metrics lookup -----------------------------------------------
# Defaults to the local alerting stack. Only bounded queries for configured services run.
PROMETHEUS_URL=http://127.0.0.1:9090
PROMETHEUS_TIMEOUT_SECONDS=5
PROMETHEUS_VERIFY_TLS=true
# Optional: use bearer auth, or set username/password for basic auth.
# PROMETHEUS_BEARER_TOKEN=
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=

# --- Read-only Loki log lookup ---------------------------------------------------------
# Start Loki with: docker compose -f extras/docker-compose.loki.yml up -d
# Start the Alloy Docker log collector with: docker compose -f extras/docker-compose.alloy.yml up -d
LOKI_URL=http://127.0.0.1:3100
LOKI_TIMEOUT_SECONDS=5
LOKI_VERIFY_TLS=true
SENTINEL_LOGS_FIXTURE_FALLBACK=false
# Optional for a secured/tenant Loki deployment:
# LOKI_BEARER_TOKEN=
# LOKI_USERNAME=
# LOKI_PASSWORD=
# LOKI_TENANT_ID=

# --- Optional overrides ---------------------------------------------------------------
# Use another OpenAI-compatible provider (e.g. OpenRouter) and its model slugs:
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# SENTINEL_PRIMARY_MODEL=openai/gpt-4o-mini
# SENTINEL_FALLBACK_MODEL=anthropic/claude-haiku-4.5

# Repository the legacy GitHub commit-history context tool reads (not deployment evidence):
# GITHUB_REPO_OWNER=<your-github-username>
# GITHUB_REPO_NAME=sentinel-agent

# Read-only explicit GitHub Deployments lookup for checkout-service. Public repositories
# work without a token; private repos need a fine-grained token with Deployments: read.
SENTINEL_GITHUB_DEPLOYMENT_ENVIRONMENT=demo
SENTINEL_GITHUB_DEPLOYMENTS_TIMEOUT_SECONDS=5
# SENTINEL_GITHUB_DEPLOYMENTS_TOKEN=<read-only-token>

# Dedicated mock checkout repository used for issue-first, human-reviewed repair PRs.
# Use a separate fine-grained token or GitHub App installation scoped only to that repository with
# Contents: read/write, Issues: read/write, Pull requests: read/write, and Checks: read. Keep it
# separate from the optional Deployments: read token above and store the actual value in local .env only.
# SENTINEL_GITHUB_TOKEN=github_pat_...
# SENTINEL_DEMO_GITHUB_OWNER=<your-github-username>
# SENTINEL_DEMO_GITHUB_REPO=checkout-demo-app
# SENTINEL_DEMO_APP_URL=http://127.0.0.1:8000
# SENTINEL_DEMO_APP_CONFIG_PATH=C:\Users\you\Downloads\checkout-demo-app\app\settings.json

# --- Read-only Confluence runbook search -----------------------------------------------
# Leave CONFLUENCE_SPACE_KEYS blank to use the local runbook fixture. Configure an explicit
# comma-separated allowlist of space keys before live search is enabled.
CONFLUENCE_BASE_URL=https://iiitrr.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_CLOUD_ID=
CONFLUENCE_SPACE_KEYS=
# Optional: narrow live search to pages carrying this label (for example: runbook).
# CONFLUENCE_RUNBOOK_LABEL=runbook
CONFLUENCE_TIMEOUT_SECONDS=8

# Optional: mirror tickets to a REAL ServiceNow instance (free Personal Developer Instance works).
# Without these three, tickets stay in the selected local SQLite/JSON store.
# Set SERVICENOW_ENABLED=true only when you intentionally want real incident writes.
SERVICENOW_ENABLED=false
# SERVICENOW_INSTANCE=dev12345            # or the full https://dev12345.service-now.com
# SERVICENOW_USER=admin
# SERVICENOW_PASSWORD=<your PDI admin password>
# SERVICENOW_CLOSE_CODE=Solution provided   # must match a Resolution code choice on your instance
# SERVICENOW_CALLER=admin                 # user_name shown as Caller (default: SERVICENOW_USER)
# SERVICENOW_ASSIGNEE=<user_name>        # default: an active member of the assignment group
# SERVICENOW_ASSIGNMENT_GROUP=Software    # assignment group name
