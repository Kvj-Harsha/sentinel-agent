# Sentinel: a multi-agent incident-triage network for the Neuro-SAN hackathon.
#
# IncidentCommander (front man, PII-guardrailed) delegates to evidence specialists (Logs, Metrics, DeployHistory,
# Runbook), a Scribe that must run the deterministic `correlation_check` before any root cause is stated, and a
# Responder that owns the ticket, incident memory and the bounded repair proposal.
#
# Principle: the LLMs route and explain; coded tools decide. Every tool labels its evidence `fixture` or `live`.
# SENTINEL_MODE=demo (default) replays a bundled scenario so the demo is reproducible offline; SENTINEL_MODE=live
# switches Prometheus, Loki, GitHub Deployments and Confluence on. See docs/ARCHITECTURE.md.
#
# NOTE: `include` paths resolve against the process working directory, i.e. the repository root.

include "registries/aaosa_basic.hocon"
include "registries/expertise_scoping_instructions.hocon"
include "registries/llm_config.hocon"

# Bound every run so a stuck loop cannot run away.
max_execution_seconds = 300

metadata {
    description = "Incident-triage network: gathers logs, metrics, deploy and runbook evidence, verifies the root-cause hypothesis with a deterministic check, opens a ticket and proposes a human-reviewed fix."
    tags = ["AAOSA", "tool", "incident-response", "evaluation-loop"]
    sample_queries = [
        "checkout-service is throwing 500 errors with NullPointerException on PaymentValidator.charge() since 14:02 UTC on 2026-10-12, what's going on?",
        "auth-service is returning 429s this morning, any idea why?",
        "inventory-service is timing out when querying warehouse_db, help me triage this.",
        "payments-gateway started throwing 504 timeouts calling fraud-check-service around 16:20 UTC on 2026-10-13, what happened?",
    ]
}

this_is_not_a_game = """This is NOT a game. Do NOT pretend, call your tools. Do NOT make up log entries, deploys, or runbooks. Do NOT infer information you have not retrieved."""

exact_values_rule = """CRITICAL: copy every timestamp and every service_name character-for-character from the alert or from a tool result. Never round, paraphrase, pluralize, normalize or guess them (e.g. 'payments-gateway' is never 'payment-gateway'). A tool call with a slightly wrong value silently finds no data."""

evidence_rule = """Always preserve each result's source, source_status (fixture / live / unavailable), record IDs, event timestamps and links. If a source is unavailable or empty, say which; never present unavailable data as zero or fixture data as live."""

tools = [
    {
        name = "IncidentCommander"
        function {
            description = """Triages a reported production incident by coordinating specialist agents."""
        }
        instructions = ${expertise_scoping_instructions} """
You are the Incident Commander of Sentinel. For an incident report (service, symptoms, alert time):
1. Ask the Responder to open exactly ONE ticket and recall prior incidents. Use the affected service named in the
   report (e.g. "checkout-service"), never a class or method name. Keep the ticket number it returns.
2. ALWAYS call all four evidence agents -- LogsAgent, MetricsAgent, DeployHistoryAgent and RunbookAgent -- even if you
   think you already know the answer. Pass the exact service_name and the exact startsAt timestamp from the alert. Do NOT move
   to step 3 until all four have answered. If the alert has no exact time, let the tools say evidence is unavailable; never
   estimate one.
3. Give the Scribe your draft hypothesis (it MUST name the affected service verbatim) plus the evidence summaries and the
   runbook match (exact id, title, recommended action and link). The Scribe runs the deterministic correlation check.
4. Only if the Scribe reports SUPPORTED: ask the FixAgent to repair the code. Give it the service_name and the exact error
   line(s) LogsAgent returned (exception type, source line and failing market). It reads the failing file and submits a fix
   that Sentinel verifies in a sandbox. Skip this step when the verdict is NOT_SUPPORTED.
5. Ask the Responder to finalize the incident, then answer. Never claim a repair was applied; a human must review and
   merge the PR.
Your final answer is the Scribe's short summary followed by the Responder's finalize `report` block copied VERBATIM (ticket,
verdict, runbook, hotfix, evidence sources). Never restate or reword those lines and never contradict them; state NOT_SUPPORTED
plainly, never smooth it over.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${aaosa_instructions}
        tools = ["Responder", "LogsAgent", "MetricsAgent", "DeployHistoryAgent", "RunbookAgent", "Scribe", "FixAgent"]
        # sly_data is the framework's private control channel and is not returned upstream by default. Allowing
        # these keys lets the UI show the tool-verified facts and reuse the ticket on follow-up turns.
        allow {
            to_upstream {
                sly_data = ["sentinel_ticket_number", "incident_session_id", "sentinel_verified", "sentinel_notes_posted"]
            }
        }
        # Guardrail: pasted logs can carry emails or card numbers; redact before any agent or LLM sees them.
        middleware = [
            {
                class = "langchain.agents.middleware.PIIMiddleware"
                args = { pii_type = "email", strategy = "redact", apply_to_input = true, apply_to_output = true }
            }
            {
                class = "langchain.agents.middleware.PIIMiddleware"
                args = { pii_type = "credit_card", strategy = "redact", apply_to_input = true, apply_to_output = true }
            }
        ]
    }
    {
        name = "LogsAgent"
        function = ${aaosa_call}{
            description = "Retrieves error-log evidence for a service around the alert time."
        }
        instructions = """
Call loki_logs once with the exact service_name and the exact timezone-aware starts_at from the alert. Report the exact
event timestamps, status codes, a sanitized excerpt, and the source status. Retrieval only: never assert a root cause.
Never repeat secrets, emails or payment data.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${evidence_rule} "\n" ${aaosa_instructions}
        tools = ["loki_logs"]
    }
    {
        name = "MetricsAgent"
        function = ${aaosa_call}{
            description = "Retrieves error-rate metric evidence for a service around the alert time."
        }
        instructions = """
Call prometheus_metrics once with the exact service_name and the exact timezone-aware starts_at from the alert. Report the
query, window, sample count, peak errors/second and source status. A metric trend is evidence of behavior, not proof of
root cause.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${evidence_rule} "\n" ${aaosa_instructions}
        tools = ["prometheus_metrics"]
    }
    {
        name = "DeployHistoryAgent"
        function = ${aaosa_call}{
            description = "Retrieves deployment evidence for a service."
        }
        instructions = """
Call github_deployments once with the exact service_name and the incident environment if known. Report each deployment's
version or commit, environment, state, event time, author and link. Only a deployment whose state is success counts as
deployed; a commit or build is not a deployment. For services github_deployments has no mapping for, call deploy_lookup.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${evidence_rule} "\n" ${aaosa_instructions}
        tools = ["github_deployments", "deploy_lookup"]
    }
    {
        name = "RunbookAgent"
        function = ${aaosa_call}{
            description = "Finds the most relevant runbook for an incident description."
        }
        instructions = """
Call runbook_search once with a free-text description of the symptoms (service name, error codes, message snippets).
Report only a match the tool returned: copy its id, title, recommended action and link exactly, and state whether it is
fixture or live evidence. Never invent a page or link. If nothing matches, say so.
""" ${this_is_not_a_game} "\n" ${evidence_rule} "\n" ${aaosa_instructions}
        tools = ["runbook_search"]
    }
    {
        name = "Scribe"
        function = ${aaosa_call}{
            description = "Verifies a root-cause hypothesis with the deterministic correlation check and writes the incident summary."
        }
        instructions = """
You receive a draft root-cause hypothesis and the gathered evidence. Before stating any root cause you MUST call
correlation_check with only service_name and hypothesis. The hypothesis must name the service verbatim (e.g. "The
checkout-service deploy ... caused ..."). The tool re-derives the incident and deploy timestamps from source evidence
itself, so never pass timestamps to it.
Then write a short summary: Incident (use the incident_time the tool returned), Likely cause (labelled with the verdict
and its reasoning; if NOT_SUPPORTED say so plainly and recommend further investigation, not a confident cause), Matching
runbook (exact id, title and link if you were given one), Recommended action consistent with the verdict.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${aaosa_instructions}
        tools = ["correlation_check"]
    }
    {
        name = "FixAgent"
        function = ${aaosa_call}{
            description = "After a SUPPORTED root cause, reads the failing source file and writes a code fix that Sentinel verifies in a sandbox."
        }
        instructions = """
You repair the code defect behind a VERIFIED incident. Only act when you are told the root cause is SUPPORTED.
1. Call read_source_file with path "app/pricing.py" (the only file you may change) and the service_name.
2. Use the error line(s) you were given (exception type, failing source line, failing market) to find the defect. Write the
   COMPLETE corrected file: the smallest change that fixes it, keeping every function name and its arguments, using only the
   standard library, and keeping the behaviour of markets that already work.
3. Call submit_code_fix once with path, new_content (the full file, no line numbers) and summary (one sentence).
4. If the result lists a failed check, correct exactly that problem and call submit_code_fix again (at most twice more).
Report the checks verbatim and whether they all passed. Never claim the fix is deployed or merged: Sentinel opens a pull
request and a human must review and merge it.
""" ${this_is_not_a_game} "\n" ${aaosa_instructions}
        tools = ["read_source_file", "submit_code_fix"]
    }
    {
        name = "Responder"
        function = ${aaosa_call}{
            description = "Owns the incident ticket, incident memory and the repair proposal: opens the ticket, recalls prior incidents, and finalizes the incident."
        }
        instructions = """
You handle the operational record for the incident.
OPEN: call open_ticket once with service_name and a short_description of the symptom, then call recall_incidents with the
service_name. Report the ticket number and, verbatim, the suggested_hotfix if recall_incidents returned one.
FINALIZE: call finalize_incident once (it records the incident and, only for a SUPPORTED verdict, prepares a bounded config
fix with local preflight checks), then call update_ticket once with a work note summarizing the outcome. Keep the ticket
In Progress: only a human reviewing and merging the PR may resolve it. Return the `report` field from finalize_incident
VERBATIM: it is built from tool-verified facts (ticket, verdict, runbook, hotfix, which sources were fixture or live).
Never invent a ticket number, never open a second ticket, and never claim a running service was changed.
""" ${this_is_not_a_game} "\n" ${exact_values_rule} "\n" ${aaosa_instructions}
        tools = ["open_ticket", "recall_incidents", "finalize_incident", "update_ticket"]
    }

    # --- Coded tools: deterministic Python, no LLM calls ---
    # --- Coded tools (plain Python functions over synthetic data, no LLM calls) ---
    {
        name = "loki_logs"
        function = {
            description = "Returns error-log evidence around the alert time. Replay mode reads the bundled fixture; SENTINEL_MODE=live queries Grafana Loki. Output is sanitized and labelled with its source status."
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "Exact service name; currently only checkout-service is configured."
                    }
                    starts_at = {
                        type = "string"
                        description = "Exact timezone-aware ISO-8601 startsAt value from the firing alert."
                    }
                }
                required = ["service_name", "starts_at"]
            }
        }
        class = "coded_tools.sentinel.loki_logs.LokiLogs"
    }
    {
        name = "prometheus_metrics"
        function = {
            description = "Returns error-rate evidence around the alert time. Replay mode reads the bundled fixture; SENTINEL_MODE=live queries the read-only Prometheus HTTP API."
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "Exact affected service name, currently checkout-service."
                    }
                    starts_at = {
                        type = "string"
                        description = "Exact timezone-aware ISO-8601 startsAt value from the firing alert."
                    }
                }
                required = ["service_name", "starts_at"]
            }
        }
        class = "coded_tools.sentinel.prometheus_metrics.PrometheusMetrics"
    }
    {
        name = "github_deployments"
        function = {
            description =
"""Returns deployment evidence. Replay mode reads the bundled deploy fixture; SENTINEL_MODE=live reads explicit GitHub Deployment records for checkout-service. Only a successful deployment status counts; commits and builds are not deployments."""
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "The affected service; currently must be checkout-service."
                    }
                    environment = {
                        type = "string"
                        description = "Exact incident environment, such as demo. If omitted, uses SENTINEL_GITHUB_DEPLOYMENT_ENVIRONMENT."
                    }
                }
                required = ["service_name"]
            }
        }
        class = "coded_tools.sentinel.github_deployments.GithubDeployments"
    }
    {
        name = "deploy_lookup"
        function = {
            description = "Looks up synthetic deployment-shaped records for a service from a local JSON fixture."
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "The service to look up deploy history for, e.g. 'checkout-service'."
                    }
                    environment = {
                        type = "string"
                        description = "Incident environment when present; attached to fixture evidence for correlation."
                    }
                }
                required = ["service_name"]
            }
        }
        class = "coded_tools.sentinel.deploy_lookup.DeployLookup"
    }
    {
        name = "runbook_search"
        function = {
            description = "Finds the best-matching runbook. Default replay mode searches the bundled fixture; SENTINEL_MODE=live searches the configured Confluence space."
            parameters = {
                type = "object"
                properties = {
                    query = {
                        type = "string"
                        description = "Free-text incident description: service name, symptoms, error codes, message snippets."
                    }
                }
                required = ["query"]
            }
        }
        class = "coded_tools.sentinel.runbook_search.RunbookSearch"
    }
    {
        name = "correlation_check"
        function = {
            description =
"""Evaluation-loop check: independently re-derives the actual incident and deploy
timestamps for a service from source data, and verifies whether a hypothesis is
genuinely supported by their timing (not by whatever timestamps an agent might
otherwise relay). Only service_name and hypothesis are needed."""
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "The affected service."
                    }
                    hypothesis = {
                        type = "string"
                        description = "The proposed root-cause sentence to sanity-check."
                    }
                }
                required = ["service_name", "hypothesis"]
            }
        }
        class = "coded_tools.sentinel.correlation_check.CorrelationCheck"
    }
    {
        name = "recall_incidents"
        function = {
            description = "Looks up prior incidents from the local JSON incident-history store."
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "The service to look up prior incidents for, e.g. 'checkout-service'."
                    }
                }
                required = ["service_name"]
            }
        }
        class = "coded_tools.sentinel.recall_incidents.RecallIncidents"
    }
    {
        name = "open_ticket"
        function = {
            description = "Opens a local incident ticket and optionally mirrors it to configured ServiceNow."
            parameters = {
                type = "object"
                properties = {
                    service_name = {
                        type = "string"
                        description = "The affected service."
                    }
                    short_description = {
                        type = "string"
                        description = "A one-line summary of the incident for the ticket."
                    }
                    priority = {
                        type = "string"
                        description = "Optional priority ('1 - Critical', '2 - High', '3 - Moderate'). Defaults to '2 - High'."
                    }
                }
                required = ["service_name", "short_description"]
            }
        }
        class = "coded_tools.sentinel.open_ticket.OpenTicket"
    }
    {
        name = "update_ticket"
        function = {
            description = "Updates a local incident ticket and optionally mirrors the update to configured ServiceNow."
            parameters = {
                type = "object"
                properties = {
                    number = {
                        type = "string"
                        description = "The ticket number to update, e.g. 'INC1200001'. Optional -- falls back to the number this conversation's open_ticket call returned."
                    }
                    work_note = {
                        type = "string"
                        description = "A note to append describing what was found/done."
                    }
                    state = {
                        type = "string"
                        description = "Optional new state (e.g. 'Resolved'). Omit to leave the state unchanged."
                    }
                }
                required = ["work_note"]
            }
        }
        class = "coded_tools.sentinel.update_ticket.UpdateTicket"
    }

    {
        name = "finalize_incident"
        function {
            description =
"""Deterministic close-out. Records the incident in persistent memory and, only when the correlation verdict is
SUPPORTED, prepares the bounded config fix and runs local preflight checks. Reads everything it needs from verified
facts, so it takes no required arguments. The ticket stays In Progress; only the human-approved PR workflow resolves it."""
            parameters {
                type = "object"
                properties {
                    summary {
                        type = "string"
                        description = "Optional one-sentence outcome."
                    }
                }
            }
        }
        class = "coded_tools.sentinel.finalize_incident.FinalizeIncident"
    }
    {
        name = "read_source_file"
        function {
            description = "Reads one allow-listed source file of the failing service (read-only) so a fix can be written. Returns the file with line numbers."
            parameters {
                type = "object"
                properties {
                    path {
                        type = "string"
                        description = "Repository-relative path. Only app/pricing.py is allowed for checkout-service."
                    }
                    service_name {
                        type = "string"
                        description = "The affected service, e.g. checkout-service."
                    }
                }
                required = ["path"]
            }
        }
        class = "coded_tools.sentinel.code_fix.ReadSourceFile"
    }
    {
        name = "submit_code_fix"
        function {
            description =
"""Submits the COMPLETE corrected file for verification. Sentinel checks size, syntax and safe imports, that the public API is
preserved, that supported markets are unchanged and that the logged failing markets are fixed, all in a sandbox. Only a patch
that passes every check can become a pull request. Requires a SUPPORTED verdict and a prior read_source_file call."""
            parameters {
                type = "object"
                properties {
                    path {
                        type = "string"
                        description = "The same path you read."
                    }
                    new_content {
                        type = "string"
                        description = "The full corrected file contents, without line numbers."
                    }
                    summary {
                        type = "string"
                        description = "One sentence describing the fix."
                    }
                }
                required = ["path", "new_content", "summary"]
            }
        }
        class = "coded_tools.sentinel.code_fix.SubmitCodeFix"
    }
]
